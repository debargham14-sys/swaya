# Local development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dsv

# Cloud (MongoDB Atlas) — use in Render / Railway dashboard:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# gridfs = store bundles + raw photos in MongoDB (required for cloud hosts)
# disk   = legacy local ZIP files under SCAN_STORAGE_DIR
SCAN_STORAGE_BACKEND=gridfs
SCAN_STORAGE_DIR=./data/scans

# Set to 1 only when torch + 4D-Humans are installed (not on cloud deploy image)
BUNDLE_TRY_MESH=0

# Photos: s3 for production (MongoDB stores links); gridfs for local dev without AWS
PHOTO_STORAGE=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket
S3_PHOTO_PREFIX=dsv/scans

# Fit assistant LLM (optional — falls back to rule-based suggestions)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
