# --- DynamoDB (scan + calibration metadata) ---
# Tables are {DYNAMO_TABLE_PREFIX}_{scans,calibration,vest_scans,vest_calibration}.
# On AWS (EC2 instance role / configured creds) leave DYNAMO_ENDPOINT_URL empty.
DYNAMO_TABLE_PREFIX=dsv
# Local dev without AWS: run a DynamoDB-compatible endpoint and point here, e.g.
#   moto_server -p 5055        (pip install 'moto[server]')
#   docker run -p 8000:8000 amazon/dynamodb-local
# DYNAMO_ENDPOINT_URL=http://localhost:5055

# Blob storage for bundles + raw photos (DynamoDB items cap at 400 KB):
#   s3   = production (DynamoDB stores the links)
#   disk = local dev without AWS (files under SCAN_STORAGE_DIR)
SCAN_STORAGE_BACKEND=disk
SCAN_STORAGE_DIR=./data/scans

# Set to 1 only when torch + 4D-Humans are installed (not on cloud deploy image)
BUNDLE_TRY_MESH=0

PHOTO_STORAGE=disk
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=your-bucket
S3_PHOTO_PREFIX=dsv/scans

# Fit assistant LLM (optional — falls back to rule-based suggestions)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Firebase Authentication ---
# The mobile app signs in with Firebase; the API verifies the Firebase ID token.
# Provide ONE of the following. If none are set, auth is disabled (local dev).
#
# 1) Inline service-account JSON (best for Render/Railway secret env vars):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
#
# 2) Path to a service-account JSON file (Application Default Credentials):
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json
# FIREBASE_PROJECT_ID=your-firebase-project-id
#
# Force 401s even when no credentials are configured (use on shared/staging):
# AUTH_REQUIRED=0
