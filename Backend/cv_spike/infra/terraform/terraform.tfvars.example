# Copy to terraform.tfvars and fill in. Only s3_bucket_name must be changed.

aws_region          = "us-east-1"
project             = "swaya-dsv"
dynamo_table_prefix = "dsv" # must match DYNAMO_TABLE_PREFIX in the API

# Globally-unique bucket name for photos + bundles. MUST be unique across all AWS.
s3_bucket_name = "swaya-dsv-blobs-CHANGEME"

# EC2
instance_type    = "t3.medium"
key_name         = "" # existing EC2 key pair name for SSH, or leave empty
ssh_ingress_cidr = "203.0.113.10/32" # your.ip/32 — keep SSH locked to you
# api_ingress_cidr defaults to 0.0.0.0/0 (API Gateway reaches the box over the internet)

# Container image (built + pushed to ECR by push_image.sh)
image_tag     = "latest"
auth_required = "0" # "1" once firebase_ssm_parameter is set (API is OPEN at "0")

# Firebase auth (optional): name of an SSM SecureString holding the service-account
# JSON. Create it out-of-band so the secret stays out of Terraform state:
#   aws ssm put-parameter --type SecureString \
#     --name /swaya-dsv/firebase-credentials --value file://serviceAccount.json
firebase_ssm_parameter = ""
